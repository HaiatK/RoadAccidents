import kagglehub
import pandas as pd
import os

# Download dataset from Kaggle
path = kagglehub.dataset_download("fatimahalbaik1/injured-and-dead-in-accidents")

# Display files inside the dataset folder (optional)
print("Files in dataset folder:", os.listdir(path))

# Load the dataset
df = pd.read_csv(path + "/Injured and Dead in Accidents.csv")

# Display basic information
print("\nFirst 5 rows:")
print(df.head())

print("\nDataset shape:")
print(df.shape)

print("\nDataset information:")
df.info()

print("\nStatistical summary:")
print(df.describe())
